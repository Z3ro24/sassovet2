{
  "redirects": [
    {
      "source": "/rancagua",
      "destination": "/veterinaria-a-domicilio-rancagua",
      "permanent": true
    },
    {
      "source": "/machali",
      "destination": "/veterinaria-a-domicilio-machali",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "drasassovet.cl"
        }
      ],
      "destination": "https://www.drasassovet.cl/$1",
      "permanent": true
    }
  ]
}
