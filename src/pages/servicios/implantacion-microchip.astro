---
import Layout from '../../layouts/Layout.astro'
import Header from '../../components/landig/Header.astro'
import Footeer from '../../components/landig/Footer.astro'

const pageTitle = 'Implantación de Microchip a Domicilio en Rancagua y Machalí | Dra. Fernanda Sasso'
const pageDescription =
  'Implantación y registro de microchip para mascotas a domicilio en Rancagua, Machalí y Olivar. Identificación permanente con certificado oficial.'
const pageUrl = 'https://www.drasassovet.cl/servicios/implantacion-microchip'
const pageImage = 'https://drasassovet.cl/_astro/foto2.DQJT7_xQ_2uj8Ns.webp'
---

<Layout title={pageTitle} description={pageDescription} url={pageUrl} image={pageImage}>
  <Header />
  <section class="container mx-auto px-4 py-12 max-w-3xl">
    <h1 class="text-3xl font-bold mb-2">Implantación de Microchip a Domicilio</h1>
    <h2 class="text-xl text-gray-500 mb-6">Servicio veterinario a domicilio en Rancagua, Machalí y Olivar</h2>
    <p class="text-gray-700 mb-6">
      Nuestro servicio de <strong>implantación de microchip a domicilio</strong> garantiza la identificación permanente de tu mascota
      de forma segura y sin traslados. Realizamos el procedimiento con <strong>criterio profesional</strong> y entregamos el certificado
      de registro.
    </p>

    <h2 class="text-xl font-semibold mb-2">Proceso</h2>
    <ul class="list-disc list-inside mb-6 text-gray-700">
      <li>Implantación subcutánea del microchip</li>
      <li>Registro del chip y entrega de certificado</li>
      <li>Consejos para cuidado post-procedimiento</li>
      <li>Verificación correcta de funcionamiento</li>
    </ul>

    <p class="text-gray-700 mb-6">
      Disponible en <strong>Rancagua</strong>, <strong>Machalí</strong> y <strong>Olivar</strong>. Consulta precio y disponibilidad
      por WhatsApp.
    </p>

    <a
      href="https://wa.me/56954047440?text=Hola,%20quiero%20implantar%20un%20microchip%20a%20mi%20mascota"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center bg-blue-600 text-white px-6 py-3 rounded-full shadow hover:bg-blue-700 transition"
    >
      Agendar por WhatsApp
    </a>
  </section>
  <Footeer />
</Layout>
