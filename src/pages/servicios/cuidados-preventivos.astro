---
import Layout from '../../layouts/Layout.astro'
import Header from '../../components/landig/Header.astro'
import Footeer from '../../components/landig/Footer.astro'

const pageTitle = 'Manejo de Heridas y Cuidados Preventivos a Domicilio | Dra. Fernanda Sasso'
const pageDescription =
  'Curaciones, manejo de heridas y cuidados preventivos a domicilio en Rancagua, Machalí y Olivar. Atención profesional para mantener a tu mascota sana.'
const pageUrl = 'https://www.drasassovet.cl/servicios/cuidados-preventivos'
const pageImage = 'https://drasassovet.cl/_astro/foto2.DQJT7_xQ_2uj8Ns.webp'
---

<Layout title={pageTitle} description={pageDescription} url={pageUrl} image={pageImage}>
  <Header />
  <section class="container mx-auto px-4 py-12 max-w-3xl">
    <h1 class="text-3xl font-bold mb-2">Manejo de Heridas y Cuidados Preventivos</h1>
    <h2 class="text-xl text-gray-500 mb-6">Servicio veterinario a domicilio en Rancagua, Machalí y Olivar</h2>
    <p class="text-gray-700 mb-6">
      Nuestro servicio de <strong>cuidados preventivos a domicilio</strong> incluye curaciones, manejo de heridas y seguimiento de
      lesiones directamente en tu hogar. Mantenemos a tu mascota sana con <strong>atención profesional</strong> sin traslados.
    </p>

    <h2 class="text-xl font-semibold mb-2">Servicios incluidos</h2>
    <ul class="list-disc list-inside mb-6 text-gray-700">
      <li>Curaciones y manejo de heridas</li>
      <li>Seguimiento de las lesiones</li>
      <li>Cuidados preventivos y de higiene</li>
      <li>Recomendaciones post-tratamiento</li>
    </ul>

    <p class="text-gray-700 mb-6">
      Atendemos en <strong>Rancagua</strong>, <strong>Machalí</strong> y <strong>Olivar</strong>. Agenda tu cita de cuidados preventivos
      por WhatsApp.
    </p>

    <a
      href="https://wa.me/56954047440?text=Hola,%20quiero%20un%20servicio%20preventivo%20para%20mi%20mascota"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center bg-blue-600 text-white px-6 py-3 rounded-full shadow hover:bg-blue-700 transition"
    >
      Agendar por WhatsApp
    </a>
  </section>
  <Footeer />
</Layout>
