---
import Layout from '../../layouts/Layout.astro'
import Header from '../../components/landig/Header.astro'
import Footeer from '../../components/landig/Footer.astro'
const title = 'Atención de urgencias'
const description =
  'Manejo inicial de emergencias a domicilio y coordinación de traslados si es necesario.'
const price = 'Variable (según atención)'
---

<Layout title={title} description={description}>
  <Header />
  <section class="container mx-auto px-4 py-12 max-w-3xl">
    <h1 class="text-3xl font-bold mb-2">{title}</h1>
    <h2 class="text-xl text-gray-500 mb-6">Servicio veterinario a domicilio</h2>
    <p class="text-gray-700 mb-6">{description}</p>

    <h2 class="text-xl font-semibold mb-2">Cómo funciona</h2>
    <ul class="list-disc list-inside mb-6 text-gray-700">
      <li>Evaluación y estabilización inicial</li>
      <li>Soporte básico y manejo del dolor</li>
      <li>Coordinación de traslado a clínica si es necesario</li>
    </ul>

    <p class="text-lg font-semibold mb-6">Precio orientativo: {price}</p>

    <a
      href="https://wa.me/56954047440?text=Urgencia:%20necesito%20atenci%C3%B3n%20inmediata"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center bg-blue-600 text-white px-6 py-3 rounded-full shadow hover:bg-blue-700 transition"
    >
      Contactar por WhatsApp
    </a>
  </section>
  <Footeer />
</Layout>
