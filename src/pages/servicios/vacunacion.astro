---
import Layout from '../../layouts/Layout.astro'
import Header from '../../components/landig/Header.astro'
import Footeer from '../../components/landig/Footer.astro'

const pageTitle = 'Vacunación y Prevención a Domicilio en Rancagua y Machalí | Dra. Fernanda Sasso'
const pageDescription =
  'Servicio de vacunación y desparasitación a domicilio en Rancagua, Machalí y Olivar. Programas personalizados según la edad y estilo de vida de tu mascota.'
const pageUrl = 'https://www.drasassovet.cl/servicios/vacunacion'
const pageImage = 'https://drasassovet.cl/_astro/foto2.DQJT7_xQ_2uj8Ns.webp'
---

<Layout title={pageTitle} description={pageDescription} url={pageUrl} image={pageImage}>
  <Header />
  <section class="container mx-auto px-4 py-12 max-w-3xl">
    <h1 class="text-3xl font-bold mb-2">Vacunación y Prevención a Domicilio</h1>
    <h2 class="text-xl text-gray-500 mb-6">Servicio veterinario a domicilio en Rancagua, Machalí y Olivar</h2>
    <p class="text-gray-700 mb-6">
      Nuestro servicio de <strong>vacunación a domicilio</strong> permite mantener a tu mascota protegida sin traslados innecesarios.
      Adaptamos el <strong>esquema de vacunación</strong> según la edad, estilo de vida y riesgo epidemiológico de cada animal.
    </p>

    <h2 class="text-xl font-semibold mb-2">Qué hacemos</h2>
    <ul class="list-disc list-inside mb-6 text-gray-700">
      <li>Aplicación de vacunas según calendario veterinario</li>
      <li>Consejos y plan de desparasitación</li>
      <li>Registro de vacunaciones y recomendaciones</li>
      <li>Evaluación previa a la vacunación</li>
    </ul>

    <p class="text-gray-700 mb-6">
      Trabajamos en <strong>Rancagua</strong>, <strong>Machalí</strong> y <strong>Olivar</strong>. Agenda la vacunación de tu mascota
      con un solo mensaje por WhatsApp.
    </p>

    <a
      href="https://wa.me/56954047440?text=Hola,%20quiero%20vacunar%20a%20mi%20mascota"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center bg-blue-600 text-white px-6 py-3 rounded-full shadow hover:bg-blue-700 transition"
    >
      Agendar por WhatsApp
    </a>
  </section>
  <Footeer />
</Layout>
