---
import Layout from '../../layouts/Layout.astro'
import Header from '../../components/landig/Header.astro'
import Footeer from '../../components/landig/Footer.astro'
const title = 'Vacunación y prevención'
const description =
  'Programas de vacunación y desparasitación adaptados a la edad y estilo de vida de tu mascota.'
const price = '$18.000 - $35.000 (según esquema)'
---

<Layout title={title} description={description}>
  <Header />
  <section class="container mx-auto px-4 py-12 max-w-3xl">
    <h1 class="text-3xl font-bold mb-2">{title}</h1>
    <h2 class="text-xl text-gray-500 mb-6">Servicio veterinario a domicilio</h2>
    <p class="text-gray-700 mb-6">{description}</p>

    <h2 class="text-xl font-semibold mb-2">Qué hacemos</h2>
    <ul class="list-disc list-inside mb-6 text-gray-700">
      <li>Aplicación de vacunas según calendario</li>
      <li>Consejos y plan de desparasitación</li>
      <li>Registro de vacunaciones y recomendaciones</li>
    </ul>

    <!-- <p class="text-lg font-semibold mb-6">Precio orientativo: {price}</p> -->

    <a
      href="https://wa.me/56954047440?text=Hola,%20quiero%20vacunar%20a%20mi%20mascota"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center bg-blue-600 text-white px-6 py-3 rounded-full shadow hover:bg-blue-700 transition"
    >
      Agendar por WhatsApp
    </a>
  </section>
  <Footeer />
</Layout>
