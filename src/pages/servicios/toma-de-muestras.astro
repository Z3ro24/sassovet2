---
import Layout from '../../layouts/Layout.astro'
import Header from '../../components/landig/Header.astro'
import Footeer from '../../components/landig/Footer.astro'

const pageTitle = 'Toma de Muestras a Domicilio en Rancagua y Machalí | Dra. Fernanda Sasso'
const pageDescription =
  'Toma de muestras sanguíneas y dermatológicas a domicilio en Rancagua, Machalí y Olivar. Interpretación profesional y diagnóstico preciso.'
const pageUrl = 'https://www.drasassovet.cl/servicios/toma-de-muestras'
const pageImage = 'https://drasassovet.cl/_astro/foto2.DQJT7_xQ_2uj8Ns.webp'
---

<Layout title={pageTitle} description={pageDescription} url={pageUrl} image={pageImage}>
  <Header />
  <section class="container mx-auto px-4 py-12 max-w-3xl">
    <h1 class="text-3xl font-bold mb-2">Toma de Muestras a Domicilio</h1>
    <h2 class="text-xl text-gray-500 mb-6">Servicio veterinario a domicilio en Rancagua, Machalí y Olivar</h2>
    <p class="text-gray-700 mb-6">
      Nuestro servicio de <strong>toma de muestras a domicilio</strong> permite realizar exámenes de laboratorio sin necesidad de traslado.
      Tomamos muestras sanguíneas y dermatológicas directamente en tu hogar, con <strong>interpretación profesional</strong> y diagnóstico preciso.
    </p>

    <h2 class="text-xl font-semibold mb-2">Qué incluye</h2>
    <ul class="list-disc list-inside mb-6 text-gray-700">
      <li>Toma de muestras sanguíneas para exámenes de laboratorio</li>
      <li>Exámenes dermatológicos para diagnóstico de problemas de piel</li>
      <li>Interpretación profesional de resultados de exámenes</li>
      <li>Diagnóstico preciso y plan de tratamiento personalizado</li>
    </ul>

    <p class="text-gray-700 mb-6">
      Disponible en <strong>Rancagua</strong>, <strong>Machalí</strong> y <strong>Olivar</strong>. Consulta el precio según el tipo de
      examen necesario.
    </p>

    <a
      href="https://wa.me/56954047440?text=Hola,%20quiero%20una%20toma%20de%20muestras%20para%20mi%20mascota"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center bg-blue-600 text-white px-6 py-3 rounded-full shadow hover:bg-blue-700 transition"
    >
      Agendar por WhatsApp
    </a>
  </section>
  <Footeer />
</Layout>
