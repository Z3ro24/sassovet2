---
import Layout from '../../layouts/Layout.astro'
import Header from '../../components/landig/Header.astro'
import Footeer from '../../components/landig/Footer.astro'
const title = 'Eutanasia a domicilio'
const description =
  'Servicio de eutanasia humanitaria y acompañamiento, con criterio profesional y respeto por el bienestar animal.'
const price = 'Precio según evaluación'
---

<Layout title={title} description={description}>
  <Header />
  <section class="container mx-auto px-4 py-12 max-w-3xl">
    <h1 class="text-3xl font-bold mb-2">{title}</h1>
    <h2 class="text-xl text-gray-500 mb-6">Servicio veterinario a domicilio</h2>
    <p class="text-gray-700 mb-6">{description}</p>

    <h2 class="text-xl font-semibold mb-2">Información importante</h2>
    <p class="text-gray-700 mb-6">
      Ofrecemos este servicio con el máximo respeto y explicamos el proceso y
      opciones para el acompañamiento familiar.
    </p>

    <p class="text-lg font-semibold mb-6">{price}</p>

    <a
      href="https://wa.me/56954047440?text=Necesito%20informaci%C3%B3n%20sobre%20eutanasia"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center bg-blue-600 text-white px-6 py-3 rounded-full shadow hover:bg-blue-700 transition"
    >
      Consultar por WhatsApp
    </a>
  </section>
  <Footeer />
</Layout>
