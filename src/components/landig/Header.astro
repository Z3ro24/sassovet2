---
import { MapPin, Phone, ChevronDown, Menu } from '@lucide/astro'

const { contactHref = '/contacto' } = Astro.props
---

<script>
  const buttons = document.querySelectorAll('button.wsp')
  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      window.open('https://wa.me/56954047440')
    })
  })

  // Mobile menu toggle
  const mobileMenuBtn = document.getElementById('mobile-menu-btn')
  const mobileMenu = document.getElementById('mobile-menu')
  if (mobileMenuBtn && mobileMenu) {
    mobileMenuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden')
    })
  }

  // Desktop dropdown toggle
  const dropdownBtn = document.getElementById('dropdown-btn')
  const dropdownMenu = document.getElementById('dropdown-menu')
  if (dropdownBtn && dropdownMenu) {
    dropdownBtn.addEventListener('click', () => {
      dropdownMenu.classList.toggle('hidden')
    })
    document.addEventListener('click', (e) => {
      if (!dropdownBtn.contains(e.target as Node) && !dropdownMenu.contains(e.target as Node)) {
        dropdownMenu.classList.add('hidden')
      }
    })
  }

  // Mobile dropdown toggle
  const mobileDropdownBtn = document.getElementById('mobile-dropdown-btn')
  const mobileDropdownMenu = document.getElementById('mobile-dropdown-menu')
  if (mobileDropdownBtn && mobileDropdownMenu) {
    mobileDropdownBtn.addEventListener('click', () => {
      mobileDropdownMenu.classList.toggle('hidden')
    })
  }
</script>

<header class="bg-white sticky top-0 z-50 shadow-md">

  <div class="container mx-auto px-4 py-3 flex items-center justify-between">
    <!-- Logo -->
    <div class="flex items-center">
      <a href="/" class="flex items-center" aria-label="Ir al inicio">
        <img
          src="/foto3.svg"
          alt="Logo Veterinaria Fernanda Sasso - Atención a domicilio"
          width="48"
          height="48"
          class="h-12 w-12 object-cover rounded-full mr-3"
        />
        <span class="text-lg font-bold text-gray-700">Dra. Fernanda Sasso</span>
      </a>
    </div>

    <!-- Navegación desktop -->
    <nav aria-label="Menú principal" class="hidden md:flex items-center gap-6">
      <a href="/" class="text-gray-600 hover:text-primary font-medium">Inicio</a>
      <a href="/servicios" class="text-gray-600 hover:text-primary font-medium"
        >Servicios</a
      >

      <!-- Dropdown Zonas de Cobertura -->
      <div class="relative">
        <button
          id="dropdown-btn"
          class="flex items-center gap-1 text-gray-600 hover:text-primary font-medium"
        >
          Zonas de Cobertura
          <ChevronDown class="w-4 h-4" />
        </button>
        <div
          id="dropdown-menu"
          class="hidden absolute top-full left-0 mt-2 bg-white shadow-lg rounded-lg py-2 min-w-[220px] z-50"
        >
          <a
            href="/veterinaria-a-domicilio-rancagua"
            class="block px-4 py-2 text-gray-700 hover:bg-gray-100"
            >Rancagua</a
          >
          <a
            href="/veterinaria-a-domicilio-machali"
            class="block px-4 py-2 text-gray-700 hover:bg-gray-100"
            >Machalí</a
          >
          <a
            href="/veterinaria-a-domicilio-olivar"
            class="block px-4 py-2 text-gray-700 hover:bg-gray-100"
            >Olivar</a
          >
        </div>
      </div>

      <a href={contactHref} class="text-gray-600 hover:text-primary font-medium"
        >Contacto</a
      >
    </nav>

    <!-- CTA WhatsApp + Hamburger -->
    <div class="flex items-center space-x-3">
      <a
        href="https://wa.me/56954047440"
        target="_blank"
        rel="noopener noreferrer"
        class="wsp flex items-center justify-center bg-green-500 text-white px-4 py-2 rounded-full text-sm font-semibold shadow hover:bg-green-600 transition-colors"
      >
        <Phone class="w-4 h-4 mr-2" />
        <span class="hidden sm:inline">WhatsApp</span>
      </a>

      <!-- Hamburger button (mobile only) -->
      <button
        id="mobile-menu-btn"
        class="md:hidden flex items-center justify-center w-10 h-10 text-gray-600 hover:text-primary"
        aria-label="Abrir menú"
      >
        <Menu class="w-6 h-6" />
      </button>
    </div>
  </div>

  <!-- Mobile menu panel -->
  <div
    id="mobile-menu"
    class="hidden md:hidden bg-white border-t border-gray-100 shadow-lg"
  >
    <nav class="container mx-auto px-4 py-4 flex flex-col gap-1">
      <a
        href="/"
        class="block px-4 py-3 text-gray-700 hover:bg-gray-100 rounded-lg font-medium"
        >Inicio</a
      >
      <a
        href="/servicios"
        class="block px-4 py-3 text-gray-700 hover:bg-gray-100 rounded-lg font-medium"
        >Servicios</a
      >

      <!-- Mobile dropdown Zonas de Cobertura -->
      <div>
        <button
          id="mobile-dropdown-btn"
          class="w-full flex items-center justify-between px-4 py-3 text-gray-700 hover:bg-gray-100 rounded-lg font-medium"
        >
          Zonas de Cobertura
          <ChevronDown class="w-4 h-4" />
        </button>
        <div id="mobile-dropdown-menu" class="hidden pl-4">
          <a
            href="/veterinaria-a-domicilio-rancagua"
            class="block px-4 py-2 text-gray-600 hover:bg-gray-50 rounded-lg"
            >Rancagua</a
          >
          <a
            href="/veterinaria-a-domicilio-machali"
            class="block px-4 py-2 text-gray-600 hover:bg-gray-50 rounded-lg"
            >Machalí</a
          >
          <a
            href="/veterinaria-a-domicilio-olivar"
            class="block px-4 py-2 text-gray-600 hover:bg-gray-50 rounded-lg"
            >Olivar</a
          >
        </div>
      </div>

      <a
        href={contactHref}
        class="block px-4 py-3 text-gray-700 hover:bg-gray-100 rounded-lg font-medium"
        >Contacto</a
      >
    </nav>
  </div>
</header>
