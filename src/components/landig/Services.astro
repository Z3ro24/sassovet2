---
import Card from '../Card.astro'
import {
  Scissors,
  Syringe,
  Home,
  Stethoscope,
  Heart,
  Shield,
  Microchip,
  Cross
} from '@lucide/astro'

const services = [
  {
    icon: Scissors,
    title: 'Corte de Uñas',
    description:
      'Corte profesional y seguro de uñas para mantener la salud de las patas de tu mascota.',
    features: [
      'Técnica especializada',
      'Herramientas adecuadas',
      'Cuidado gentil'
    ],
    href: '/servicios'
  },
  {
    icon: Syringe,
    title: 'Vacunación',
    description:
      'Programa completo de vacunas para proteger a tu mascota de diversas enfermedades.',
    features: [
      'Vacunas originales',
      'Calendario personalizado',
      'Certificado oficial'
    ],
    href: '/servicios/vacunacion'
  },
  {
    icon: Home,
    title: 'Atención a Domicilio',
    description:
      'Consultas veterinarias en la comodidad de tu hogar, reduciendo el estrés de tu mascota.',
    features: ['Sin traslados', 'Ambiente familiar', 'Horarios flexibles'],
    href: '/servicios'
  },
  {
    icon: Stethoscope,
    title: 'Consulta General',
    description:
      'Examen completo del estado de salud de tu mascota con diagnóstico profesional.',
    features: ['Examen completo', 'Diagnóstico preciso', 'Recomendaciones'],
    href: '/servicios/consulta-general'
  },
  {
    icon: Heart,
    title: 'Desparasitación',
    description:
      'Mantén a tu mascota libre de parásitos internos y externos para cuidar su salud y bienestar general.',
    features: [
      'Desparasitación interna y externa',
      'Control y seguimiento personalizado',
      'Prevención de futuras infestaciones'
    ],
    href: '/servicios'
  },
  {
    icon: Shield,
    title: 'Cuidados Preventivos',
    description:
      'Higiene, curaciones y toma de muestras en domicilio para mantener a tu mascota sana.',
    features: [
      'Prevención y control',
      'Diagnósticos certeros',
      'Detección temprana'
    ],
    href: '/servicios/cuidados-preventivos'
  },
  {
    icon: Microchip,
    title: 'Implantación de Microchip',
    description:
      'Registro e identificación oficial de tu mascota en la comodidad de tu hogar, cumpliendo con la normativa vigente.',
    features: [
      'Identificación permanente',
      'Registro oficial',
      'Procedimiento seguro'
    ],
    href: '/servicios/implantacion-microchip'
  },
  {
    icon: Cross,
    title: 'Eutanasia',
    description:
      'Servicio humanitario con acompañamiento profesional y respeto por el bienestar animal en tu hogar.',
    features: [
      'Criterio profesional',
      'Acompañamiento',
      'Respeto y dignidad'
    ],
    href: '/servicios/eutanasia'
  }
]
---

<section
  id="servicios"
  class="py-20 bg-gradient-to-r from-white to-sky-200"
  aria-label="Servicios a realizar"
>
  <div class="container mx-auto px-4">
    <div class="text-center space-y-4 mb-16">
      <h2 class="text-4xl lg:text-5xl font-bold text-primary text-shadow-lg">
        Servicios Veterinarios a Domicilio en Rancagua, Machalí y Olivar
      </h2>
      <p class="text-xl text-gray-400 max-w-2xl mx-auto">
        Realizamos vacunas, controles, desparasitación, tratamientos y más —
        todo sin que tu mascota salga de casa.
      </p>
    </div>

    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 px-4 sm:px-6 lg:px-8"
    >
      {
        services.map((service) => (
          <article class="service-card" aria-labelledby={service.title}>
            <Card
              Icon={service.icon}
              title={service.title}
              cont={service.description}
              feature={service.features}
              href={service.href}
            />
          </article>
        ))
      }
    </div>
  </div>
</section>
