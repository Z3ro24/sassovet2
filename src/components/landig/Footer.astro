              ></path>
            </svg>
            <a
              href="https://wa.me/56954047440"
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm hover:text-white">WhatsApp: +569 5404 7440</a
            >
          </li>
          <li class="flex items-start">
            <Mail class="w-5 h-5 mr-3 text-blue-400 flex-shrink-0" />
            <a
              href="mailto:f.sassovet@hotmail.com"
              class="text-sm hover:text-white">f.sassovet@hotmail.com</a
            >
          </li>
        </ul>
      </div>

      {/* COLUMNA 2: NUESTRA COBERTURA (SEO Interlinking) */}
      <div class="space-y-4">
        <h3 class="text-lg font-semibold mb-2 text-cyan-400">
          Nuestra Cobertura
        </h3>
        <ul class="space-y-2 text-gray-300">
          <li>
            <a
              href="/veterinaria-a-domicilio-rancagua"
              class="flex items-center text-sm hover:text-white"
            >
              <span class="mr-2 text-cyan-400">&bull;</span>
              Rancagua
            </a>
          </li>
          <li>
            <a
              href="/veterinaria-a-domicilio-machali"
              class="flex items-center text-sm hover:text-white"
            >
              <span class="mr-2 text-cyan-400">&bull;</span>
              Machalí
            </a>
          </li>
          <li>
            <a
              href="/veterinaria-a-domicilio-olivar"
              class="flex items-center text-sm hover:text-white"
            >
              <span class="mr-2 text-cyan-400">&bull;</span>
              Olivar
            </a>
          </li>
        </ul>
        <div class="w-full h-[180px] mt-4 rounded-lg overflow-hidden">
          <iframe
            title="Zona de cobertura veterinaria a domicilio"
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d52823.790109790556!2d-70.70998780000001!3d-34.15946749999999!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8f6615e50cfee109%3A0x102c6dc54988f87e!2sVeterinaria%20Fernanda%20Sasso%20-%20Atenci%C3%B3n%20a%20Domicilio%20Rancagua-Machali!5e0!3m2!1ses-419!2scl!4v1760676485619!5m2!1ses-419!2scl"
            class="w-full h-full border-0"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>

      {/* COLUMNA 3: HORARIO DE ATENCIÓN */}
      <div class="space-y-4">
        <h3 class="text-lg font-semibold mb-2 text-cyan-400">
          Horario de Atención
        </h3>
        <ul class="space-y-3 text-gray-300">
          <li class="flex items-start">
            <Clock class="w-5 h-5 mr-3 text-blue-400 flex-shrink-0 mt-1" />
            <div>
              <p class="text-sm font-medium">Lunes a Sábado</p>
              <p class="text-sm">9:00 - 19:00 hrs.</p>
            </div>
          </li>
          <!-- <li class="flex items-start">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5 mr-3 text-red-400 flex-shrink-0 mt-1"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <div>
              <p class="text-sm font-medium">Toma de muestras</p>
              <p class="text-sm">Consultar Disponibilidad</p>
            </div>
          </li> -->
        </ul>
        <a
          href="https://wa.me/56954047440"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center bg-green-500 hover:bg-green-600 text-white px-6 py-3 rounded-full text-sm font-semibold transition-colors mt-4"
        >
          Reservar Hora Online
        </a>
      </div>
    </div>

    {/* SUB-FOOTER */}
    <div
      class="border-t border-gray-700 mt-10 pt-6 flex flex-col md:flex-row items-center justify-between text-sm text-gray-500"
    >
      <p>
        &copy; {new Date().getFullYear()} Dra. Fernanda Sasso. Todos los derechos
        reservados.
      </p>
      <div class="flex items-center space-x-4 mt-4 md:mt-0">
        <a href="/contacto" class="hover:text-white">Política de Privacidad</a>
        <span>|</span>
        <a href="/contacto" class="hover:text-white">Términos de Servicio</a>
      </div>
    </div>
