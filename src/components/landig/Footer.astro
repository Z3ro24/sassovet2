---
import { Heart, Phone, Mail, MapPin, Clock } from '@lucide/astro'
---

<footer id="footer" class="bg-gray-800 text-white py-12 md:py-16">
  <div class="container mx-auto px-4">
    {/* GRID 3 COLUMNAS */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12">
      {/* COLUMNA 1: CONTACTO */}
      <div class="space-y-4">
        <h3 class="text-lg font-semibold mb-2 text-cyan-400">Contáctanos</h3>
        <!-- <img
          src="/foto3.svg"
          alt="Logo Veterinaria Fernanda Sasso"
          width="40"
          height="40"
          class="h-10 w-10 object-cover rounded-full"
        /> -->
        <ul class="space-y-3 text-gray-300">
          <li class="flex items-start">
            <Phone class="w-5 h-5 mr-3 text-blue-400 flex-shrink-0 mt-1" />
            <div>
              <a href="tel:+56954047440" class="text-sm hover:text-white"
                >+569 5404 7440</a
              >
            </div>
          </li>
          <li class="flex items-start">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5 mr-3 text-green-400 flex-shrink-0 mt-1"
