---
const {
  title = 'Veterinaria en Rancagua y Machalí | Atención a domicilio Dra. Fernanda Sasso',
  description = 'Veterinaria a domicilio en Rancagua y Machalí. Consultas, vacunas, toma de muestras y cuidados para tus mascotas en la comodidad de tu hogar. Agenda tu visita con Dra. Fernanda Sasso',
  url = 'https://www.drasassovet.cl',
  image = 'https://drasassovet.cl/_astro/foto2.DQJT7_xQ_2uj8Ns.webp',
  type = 'website',
  locale = 'es_CL',
  faq = null
} = Astro.props

const siteName = 'Dra. Fernanda Sasso - Veterinaria a Domicilio'
---

  <!-- SEO básico -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  <meta name="robots" content="index, follow" />
  <meta name="robots" content="max-snippet:160, max-image-preview:large" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:image" content={image} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content={locale} />
  <meta property="og:site_name" content={siteName} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />

  <!-- Idioma -->
  <meta name="language" content="Spanish" />

  <!-- JSON-LD: Veterinaria Local -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "VeterinaryCare",
    "name": "Veterinaria Fernanda Sasso",
    "image": "https://drasassovet.cl/_astro/foto2.DQJT7_xQ_2uj8Ns.webp",
    "url": "https://www.drasassovet.cl/",
    "telephone": "+56954047440",
    "email": "f.sassovet@hotmail.com",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Rancagua",
      "addressRegion": "O'Higgins",
      "addressCountry": "Chile"
    },
    "areaServed": ["Rancagua", "Machalí", "Olivar"],
    "description": "Servicio veterinario profesional a domicilio en Rancagua, Machalí y Olivar. Consultas, vacunación, toma de muestras y cuidados para tus mascotas.",
    "priceRange": "$",
    "paymentAccepted": "Cash, Transfer",
    "openingHours": ["Mo-Fr 09:00-19:00", "Sa 09:00-14:00"],
    "sameAs": ["https://www.instagram.com/dra.sassovet/"]
  })} />

  <!-- FAQ structured data (page-specific or fallback generic) -->
  {faq ? (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faq
    })} />
  ) : (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Ofrecen atención a domicilio en Rancagua y Machalí?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, ofrecemos atención veterinaria a domicilio en Rancagua, Machalí y Olivar para consultas, vacunación y cuidados preventivos."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo agendo una consulta a domicilio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Puedes agendar llamando al +56954047440 o enviando un mensaje por WhatsApp al mismo número."
          }
        }
      ]
    })} />
  )}
