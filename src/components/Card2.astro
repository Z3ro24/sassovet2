---
import { Clock, MapPin } from '@lucide/astro'

interface Props {
  title?: string
  cont?: string
  Icon: any
  det?: string
  href?: string
}

const { title, cont, Icon, det, href } = Astro.props

const Tag = href ? 'a' : 'div'
---

<Tag
  href={href}
  class:list={[
    'wrapper text-center w-full max-w-xs sm:max-w-sm md:max-w-md',
    'rounded-xl overflow-hidden shadow-lg p-6 sm:p-8 bg-white',
    'transition-transform duration-300 ease-in-out',
    'hover:scale-105 hover:shadow-xl flex flex-col items-center',
    href && 'cursor-pointer'
  ]}
>
  <div
    class="relative w-16 h-16 sm:w-20 sm:h-20 bg-green-100 rounded-full
           flex items-center justify-center mb-4 sm:mb-6
           hover:bg-green-50 transition-colors"
  >
    <Icon class="text-green-600 w-8 h-8 sm:w-10 sm:h-10" />
  </div>

  <div class="font-bold text-lg sm:text-xl mb-2 text-primary">
    {title}
  </div>

  <p class="text-gray-400 text-sm sm:text-base mb-4 sm:mb-6 flex-grow">
    {cont}
  </p>
  <!-- <div class="flex gap-1 text-blue-400">
    <Clock />
    <div class="text-gray-400">{det}</div>
  </div> -->
  {
    href && (
      <div class="mt-4 text-sm text-blue-600 font-semibold">Ver detalle →</div>
    )
  }
</Tag>
